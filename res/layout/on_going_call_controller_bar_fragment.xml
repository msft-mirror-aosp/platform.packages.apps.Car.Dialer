<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <ImageButton
            android:id="@+id/end_call_button"
            style="@style/PrimaryControllerButton"
            android:layout_width="@dimen/in_call_end_call_button_width"
            android:layout_height="@dimen/in_call_button_size"
            android:layout_marginEnd="@dimen/in_call_button_margin"
            android:src="@drawable/ic_call_end_button"
            android:tint="@android:color/black" />

    <ImageButton
            android:id="@+id/mute_button"
            style="@style/ControllerButton"
            android:layout_width="@dimen/in_call_button_width"
            android:layout_height="@dimen/in_call_button_size"
            android:layout_marginEnd="@dimen/in_call_button_margin"
            android:scaleType="center"
            android:src="@drawable/ic_mute_activatable" />

    <ImageButton
            android:id="@+id/toggle_dialpad_button"
            style="@style/ControllerButton"
            android:layout_width="@dimen/in_call_button_width"
            android:layout_height="@dimen/in_call_button_size"
            android:layout_marginEnd="@dimen/in_call_button_margin"
            android:scaleType="center"
            android:src="@drawable/ic_dialpad_activatable" />

    <FrameLayout
            android:id="@+id/voice_channel_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <ImageButton
                android:id="@+id/voice_channel_button"
                style="@style/ControllerButton"
                android:layout_width="@dimen/in_call_button_width"
                android:layout_height="@dimen/in_call_button_size"
                android:layout_marginEnd="@dimen/in_call_button_margin"
                android:scaleType="center"
                android:src="@drawable/ic_audio_route_vehicle_activatable"/>

        <TextView
                android:id="@+id/voice_channel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

    </FrameLayout>

    <LinearLayout
            android:id="@+id/button_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <ImageButton
                android:id="@+id/merge_button"
                style="@style/ControllerButton"
                android:layout_width="@dimen/in_call_button_width"
                android:layout_height="@dimen/in_call_button_size"
                android:scaleType="center"
                android:src="@drawable/ic_merge"/>

        <ImageButton
                android:id="@+id/pause_button"
                style="@style/ControllerButton"
                android:layout_width="@dimen/in_call_button_width"
                android:layout_height="@dimen/in_call_button_size"
                android:scaleType="center"
                android:src="@drawable/ic_pause_activatable"/>
    </LinearLayout>

</LinearLayout>
